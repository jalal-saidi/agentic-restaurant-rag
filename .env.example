# A model exposed through an OpenAI-compatible API.
LLM_MODEL=replace-with-your-model-id
# Required for OpenAI/authenticated endpoints; optional for a keyless local API.
OPENAI_API_KEY=
# Leave blank for OpenAI. For host Ollama under Compose, use:
# http://host.docker.internal:11434/v1
OPENAI_BASE_URL=
# Current OpenAI models use max_completion_tokens. Ollama commonly uses max_tokens.
LLM_MAX_TOKENS_PARAMETER=max_completion_tokens
LLM_MAX_TOKENS=1200
# Leave blank for models that do not accept temperature (including some reasoning models).
LLM_TEMPERATURE=
# For GPT-5.6 function tools over Chat Completions, use none.
# Leave blank for providers that do not support reasoning_effort.
LLM_REASONING_EFFORT=

# Local-process addresses. Docker Compose overrides these internally.
MCP_SERVER_URL=http://localhost:8001/mcp
API_BASE_URL=http://localhost:8000

# Runtime binding.
MCP_HOST=0.0.0.0
MCP_PORT=8001
API_HOST=0.0.0.0
API_PORT=8000
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# Data and retrieval.
DATA_ROOT=.
CHROMA_PATH=.data/chroma
RETRIEVAL_MODE=semantic
RETRIEVAL_TOP_K=5
# Maximum model-selected MCP tool rounds in one LangGraph request.
LANGGRAPH_MAX_TOOL_ROUNDS=3

# Runtime behavior.
REQUEST_TIMEOUT_SECONDS=90
CLIENT_TIMEOUT_SECONDS=300
MAX_HISTORY_MESSAGES=12
LOG_LEVEL=INFO
AGNO_TELEMETRY=false
