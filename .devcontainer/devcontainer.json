{
  "name": "Agentic Restaurant RAG",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/agentic-restaurant-rag",
  "runServices": [
    "dev",
    "mcp",
    "api",
    "web"
  ],
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "python -m pip install --no-cache-dir -e '.[dev]'",
  "forwardPorts": [
    7860,
    8000,
    8001
  ],
  "portsAttributes": {
    "7860": {
      "label": "Gradio client"
    },
    "8000": {
      "label": "FastAPI"
    },
    "8001": {
      "label": "MCP server"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ]
      }
    }
  }
}
